import random
import time
from datetime import datetime
 

# POETA FANTASMA

 
# Bancos de palavras por emoção
 
EMOCOES = {
"1": {
"nome": "Triste",
"palavras": [
"chuva", "silêncio", "saudade", "neblina",
"sombras", "solidão", "melancolia",
"adeus", "eco", "tristeza"
]
},
 
"2": {
"nome": "Apaixonado",
"palavras": [
"amor", "lua", "beijo", "coração",
"abraço", "paixão", "olhar",
"ternura", "sorriso", "destino"
]
},
 
"3": {
"nome": "Inspirado",
"palavras": [
"esperança", "estrela", "liberdade",
"sonho", "horizonte", "coragem",
"aventura", "futuro", "luz", "vitória"
]
}
}
 

# FUNÇÃO MÁQUINA DE ESCREVER

 
def escrever_lento(texto, velocidade=0.04):
for letra in texto:
print(letra, end="", flush=True)
time.sleep(velocidade)
print()
 
 

# GERAR TÍTULO

 
def gerar_titulo(lista):
modelos = [
f"O {random.choice(lista)} Esquecido",
f"Ecos de {random.choice(lista)}",
f"A Última {random.choice(lista)}",
f"Canção de {random.choice(lista)}",
f"Fragmentos de {random.choice(lista)}"
]
 
return random.choice(modelos)
 
 

# GERAR POEMA

 
def gerar_poema(lista):
 
modelos = [
f"No silêncio da {random.choice(lista)}, caminho sozinho.",
f"As sombras da {random.choice(lista)} dançam no horizonte.",
f"Cada memória guarda um pedaço de {random.choice(lista)}.",
f"O vento sussurra histórias de {random.choice(lista)}.",
f"Vejo nascer uma {random.choice(lista)} entre as estrelas.",
f"Os meus pensamentos procuram a {random.choice(lista)} perdida.",
f"Numa noite eterna encontro a {random.choice(lista)}.",
f"O eco distante canta sobre {random.choice(lista)}.",
f"Cada passo deixa marcas de {random.choice(lista)}.",
f"Mesmo longe, permanece a {random.choice(lista)}."
]
 
poema = random.sample(modelos, 6)
 
return poema
 
 

# ESTATÍSTICAS

 
def mostrar_estatisticas(poema, emocao):
 
total_palavras = sum(len(verso.split()) for verso in poema)
 
print("\n")
print("=" * 40)
print("ESTATÍSTICAS DO POEMA")
print("=" * 40)
 
print(f"Estado emocional : {emocao}")
print(f"Versos gerados : {len(poema)}")
print(f"Total palavras : {total_palavras}")
 
 

# GUARDAR FICHEIRO
 
def guardar_poema(titulo, poema, emocao):
 
data = datetime.now().strftime("%d-%m-%Y_%H-%M")
 
nome_ficheiro = f"PoetaFantasma_{data}.txt"
 
with open(nome_ficheiro, "w", encoding="utf-8") as ficheiro:
 
ficheiro.write("POETA FANTASMA\n")
ficheiro.write("=" * 40 + "\n\n")
 
ficheiro.write(f"Título: {titulo}\n")
ficheiro.write(f"Emoção: {emocao}\n\n")
 
for verso in poema:
ficheiro.write(verso + "\n")
 
print(f"\nPoema guardado em: {nome_ficheiro}")
 
 
# PROGRAMA PRINCIPAL
 
print("\n")
print("════════════════════════════════════")
print(" POETA FANTASMA")
print("════════════════════════════════════")
print("Transformando emoções em poesia")
print()
 
print("Como te sentes hoje?\n")
 
print("1 → Triste")
print("2 → Apaixonado")
print("3 → Inspirado")
 
opcao = input("\nEscolha uma opção: ")
 
if opcao not in EMOCOES:
print("Opção inválida.")
exit()
 
emocao = EMOCOES[opcao]["nome"]
palavras = EMOCOES[opcao]["palavras"]
 
titulo = gerar_titulo(palavras)
poema = gerar_poema(palavras)
 
print("\n")
print("╔══════════════════════════════╗")
print(f" {titulo}")
print("╚══════════════════════════════╝")
print()
 
for verso in poema:
escrever_lento(verso)
time.sleep(0.6)
 
mostrar_estatisticas(poema, emocao)
 
guardar = input("\nDeseja guardar o poema? (s/n): ")
 
if guardar.lower() == "s":
guardar_poema(titulo, poema, emocao)
 
print("\nObrigado/a por usar o Poeta Fantasma.")
